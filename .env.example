# Agenda Beleza: variáveis de ambiente.
# Copie para .env (cp .env.example .env). O .env nunca é versionado nem entra na imagem.
# Toda chave aqui está declarada em src/server/env.ts (um teste confere os dois lados).

# --- PostgreSQL (usado pelo docker-compose) ---
# Usuário do PostgreSQL. SOMENTE DESENVOLVIMENTO: não use em produção.
POSTGRES_USER=agenda
# Senha do PostgreSQL. SOMENTE DESENVOLVIMENTO: não use em produção.
# Se tiver caracteres especiais, ela precisa estar URL-encoded nas URLs abaixo.
POSTGRES_PASSWORD=agenda_dev
# Base de desenvolvimento criada pela imagem oficial. SOMENTE DESENVOLVIMENTO.
POSTGRES_DB=agenda_beleza
# Porta publicada no host. Ao trocar (por exemplo, 5433 com a 5432 ocupada), ajuste
# também a porta em DATABASE_URL e TEST_DATABASE_URL: o --env-file do Node não interpola variáveis.
POSTGRES_PORT=5432

# --- Banco da aplicação ---
# URL do banco para uso local (fora do container). O compose a sobrescreve com o host "postgres".
DATABASE_URL=postgresql://agenda:agenda_dev@localhost:5432/agenda_beleza
# Base dos testes de integração. Precisa ser DIFERENTE da base de DATABASE_URL.
# Os testes usam só esta variável, nunca DATABASE_URL.
TEST_DATABASE_URL=postgresql://agenda:agenda_dev@localhost:5432/agenda_beleza_test

# --- Aplicação ---
# URL pública da aplicação (http ou https). Padrão: http://localhost:3000.
APP_URL=http://localhost:3000

# --- Vitrine de componentes (D-009) ---
# Vitrine /dev/componentes (true | false; padrão false). Só para o E2E e o desenvolvimento local;
# nunca true em produção. Com next dev ela já fica ligada. Outro valor (TRUE, 1) derruba o check-env.
VITRINE_COMPONENTES=false

# --- Fila de jobs (pg-boss, processada pelo worker; política de retry de todos os jobs) ---
# Novas tentativas depois da 1ª execução (inteiro de 0 a 20). Padrão: 4 (= 5 execuções no total).
QUEUE_RETRY_LIMIT=4
# Atraso antes da 1ª nova tentativa, em segundos (inteiro de 1 a 3600). Padrão: 30.
QUEUE_RETRY_DELAY_SECONDS=30
# Backoff exponencial com jitter (true | false). Padrão: true. Com true, a k-ésima espera fica entre
# atraso*2^(k-1) e atraso*2^k segundos; com false, todas as esperas valem o atraso.
QUEUE_RETRY_BACKOFF=true

# --- Seletores de adaptador (simulado | real; padrão simulado) ---
# Com "simulado", o projeto roda sem nenhuma credencial real.
# E-mail transacional.
EMAIL_ADAPTER=simulado
# WhatsApp Cloud API. "real" exige as WHATSAPP_* abaixo (D-047).
WHATSAPP_ADAPTER=simulado
# Mercado Pago (assinaturas). "real" exige as MP_* abaixo e APP_URL com https:// (D-046).
MP_ADAPTER=simulado
# Cloudflare Turnstile (anti-bot).
TURNSTILE_ADAPTER=simulado
# Armazenamento das fotos do salão (disco no simulado; compatível com S3 no real).
STORAGE_ADAPTER=simulado

# --- WhatsApp real (só com WHATSAPP_ADAPTER=real; ignoradas no modo simulado) ---
# Token de acesso (credencial; só em memória, nunca em log). Obrigatório no modo real.
WHATSAPP_ACCESS_TOKEN=
# Versão da Graph API (^v\d+\.\d+$). Padrão: v25.0.
WHATSAPP_API_VERSION=
# Id do número de telefone da conta (só dígitos). Obrigatório no modo real.
WHATSAPP_PHONE_NUMBER_ID=
# Nomes dos 4 modelos aprovados na Meta (minúsculas, dígitos e _). Obrigatórios no modo real.
# Sugestões e textos: docs/whatsapp-templates.md.
WHATSAPP_TEMPLATE_CONFIRMACAO=
WHATSAPP_TEMPLATE_REMARCACAO=
WHATSAPP_TEMPLATE_CANCELAMENTO=
WHATSAPP_TEMPLATE_CONVITE_AVALIACAO=
# Idioma dos modelos. Padrão: pt_BR.
WHATSAPP_TEMPLATE_IDIOMA=

# --- E-mail real (só com EMAIL_ADAPTER=real; ignoradas no modo simulado) ---
# Servidor SMTP. Obrigatório no modo real.
SMTP_HOST=
# Porta SMTP (1 a 65535). Padrão: 465 com SMTP_SECURE=true; 587 nos demais casos.
SMTP_PORT=
# Usuário SMTP. Opcional, mas vem junto com SMTP_PASSWORD (os dois ou nenhum).
SMTP_USER=
# Senha SMTP. Credencial: nunca versione o valor real.
SMTP_PASSWORD=
# TLS implícito: true ou false (padrão false, que usa STARTTLS na porta 587).
SMTP_SECURE=
# Remetente: "email@dominio" ou "Nome <email@dominio>". Obrigatório no modo real.
EMAIL_FROM=

# --- Mercado Pago real (só com MP_ADAPTER=real; ignoradas no modo simulado) ---
# No modo real, APP_URL deve ser uma URL pública https:// (o MP chama <APP_URL>/api/webhooks/mercadopago).
# Access token da aplicação. Credencial: nunca versione o valor real.
MP_ACCESS_TOKEN=
# Segredo de assinatura das notificações (painel "Suas integrações" > Webhooks). Credencial.
MP_WEBHOOK_SECRET=
# Id do plano de assinatura criado no MP (R$ 79,00 mensais, 30 dias grátis). README, "Mercado Pago".
MP_PREAPPROVAL_PLAN_ID=

# --- Cloudflare Turnstile real (só com TURNSTILE_ADAPTER=real; ignoradas no modo simulado) ---
# Chave pública do widget, lida pelo servidor a cada requisição (sem NEXT_PUBLIC_). Obrigatória no modo real.
TURNSTILE_SITE_KEY=
# Chave secreta do siteverify. Credencial: nunca versione o valor real. Obrigatória no modo real.
TURNSTILE_SECRET_KEY=

# --- Armazenamento de fotos (D-021) ---
# Só com STORAGE_ADAPTER=simulado: diretório dos objetos (padrão .armazenamento, relativo ao diretório de trabalho; fora de public/).
# No compose, aponta para o volume "armazenamento". Ignorada no modo real.
ARMAZENAMENTO_DIR=
# --- Armazenamento real compatível com S3 (só com STORAGE_ADAPTER=real; ignoradas no modo simulado) ---
# Endpoint (URL http/https). Obrigatório no modo real, inclusive na AWS (endpoint regional).
S3_ENDPOINT=
# Região. Obrigatória no modo real (ex.: us-east-1; "auto" no Cloudflare R2).
S3_REGIAO=
# Nome do bucket. Obrigatório no modo real.
S3_BUCKET=
# Chave de acesso, com permissão só de PutObject, GetObject e DeleteObject no bucket. Obrigatória no modo real.
S3_ACCESS_KEY_ID=
# Segredo da chave de acesso. Credencial: nunca versione o valor real. Obrigatório no modo real.
S3_SECRET_ACCESS_KEY=
# URL pública do bucket ou da CDN, sem listagem (opcional). https (ou http em localhost). Sem ela, as fotos saem pela rota /api/fotos/<id> da app.
S3_URL_PUBLICA=
# Endereçamento por caminho: true ou false (padrão true, compatível com MinIO e R2; a AWS aceita false).
S3_FORCE_PATH_STYLE=

# --- Proteção da página pública (D-027) ---
# Proxies confiáveis à frente da app (0 a 10). 0 ignora X-Forwarded-For e todos os acessos caem num único balde de IP
# ("desconhecido"); em produção atrás de um proxy/CDN, informe quantos (ex.: 1) para o limite valer por IP.
TRUSTED_PROXY_HOPS=0
# Segredo do HMAC das chaves por número de telefone (mínimo 32 caracteres). Obrigatório com NODE_ENV=production; fora dela há um padrão de desenvolvimento. Trocá-lo zera as contagens por número.
RATE_LIMIT_SEGREDO=
# Segredo do HMAC dos links de avaliação (mínimo 32 caracteres). Obrigatório com NODE_ENV=production; fora dela há um padrão de desenvolvimento. Trocá-lo invalida os links ainda não usados.
AVALIACAO_SEGREDO=
# Chave AES-256-GCM (32 bytes: base64 ou 64 hex) que cifra os segredos TOTP do super admin (D-034). Gere com: openssl rand -base64 32. Obrigatória com NODE_ENV=production. Perdê-la ou trocá-la invalida todos os TOTP (README).
ADMIN_TOTP_CHAVE=
# Conta do super admin criada por `npm run superadmin:criar` (idempotente). Senha de 12 a 1024 caracteres; valores simulados abaixo, troque-os.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Janela fixa dos limites, em segundos (60 a 86400). Padrão 900 (15 min).
PROTECAO_JANELA_SEGUNDOS=900
# Limites por IP na janela: reservas, consultas de disponibilidade, envio de avaliação e denúncia.
PROTECAO_LIMITE_IP_RESERVA=10
PROTECAO_LIMITE_IP_DISPONIBILIDADE=60
PROTECAO_LIMITE_IP_AVALIACAO=5
PROTECAO_LIMITE_IP_DENUNCIA=5
# Limite de tentativas de reserva por número de telefone (e salão) na janela.
PROTECAO_LIMITE_NUMERO=5
